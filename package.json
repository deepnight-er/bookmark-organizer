{
  "name": "bookmark-organizer",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first bookmark organizing with inline editing, drag-and-drop and undo.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "preview": "node scripts/python.cjs scripts/serve.py",
    "build": "node scripts/python.cjs scripts/build.py",
    "version": "node scripts/version.cjs",
    "build:local": "node scripts/python.cjs scripts/build.py --sync-local",
    "check:local": "node scripts/check.cjs --local",
    "check:release": "node scripts/python.cjs scripts/check-release.py",
    "releases": "node scripts/releases.cjs"
  },
  "files": [
    "manifest.json",
    "translations.js",
    "i18n.js",
    "releases.js",
    "index.html",
    "styles.css",
    "seed.js",
    "core.js",
    "adapter.js",
    "page-tools.js",
    "appearance.js",
    "app.js",
    "background.js",
    "assets/DM-Sans.ttf",
    "assets/DM-Sans-OFL.txt",
    "assets/icon-16.png",
    "assets/icon-32.png",
    "assets/icon-48.png",
    "assets/icon-128.png",
    "LICENSE",
    "_locales/zh_CN/messages.json",
    "_locales/zh_TW/messages.json",
    "_locales/en/messages.json",
    "_locales/ja/messages.json",
    "_locales/ko/messages.json",
    "_locales/es/messages.json",
    "_locales/fr/messages.json",
    "_locales/de/messages.json",
    "_locales/pt_BR/messages.json",
    "_locales/ru/messages.json",
    "_locales/it/messages.json",
    "_locales/ar/messages.json"
  ]
}
